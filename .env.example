# Скопируйте в .env и заполните. Файл .env в git не попадает.
BOT_TOKEN=123456:ABC-ваш_токен_от_BotFather

# openai — OpenAI напрямую или ProxyAPI; genapi — GenAPI
API_PROVIDER=openai

OPENAI_API_KEY=sk-...
# Для ProxyAPI раскомментируйте (ключ тогда — от ProxyAPI):
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Для GenAPI (MODEL тогда — ID сети, например gpt-4-1-mini):
# GENAPI_KEY=...
# GENAPI_URL=https://api.gen-api.ru/api/v1/networks

MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=500
MAX_CONTEXT_MESSAGES=20
